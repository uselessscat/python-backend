---
import { Braces } from "@lucide/astro/icons";

import ThemeToggle from "@/components/buttons/ThemeToggle.astro";
import LangSwitcher from "@/components/buttons/LangSwitcher.astro";
import GithubButton from "@/components/buttons/GithubButton.astro";
import SearchBox from "@/components/search/SearchBox.astro";
---

<header
  class="sticky top-0 z-30 border-b border-border bg-white/80 dark:bg-slate-900/80 backdrop-blur"
>
  <div
    class="mx-auto container grid grid-cols-[1fr_3fr_1fr] items-center gap-4 px-3 py-3 md:px-4"
  >
    <!-- Branding -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <Braces class="h-5 w-5 text-primary" />
      <div class="flex flex-col leading-tight">
        <span class="text-xl font-semibold tracking-tight text-primary">
          Software engineering
        </span>
      </div>
    </a>

    <!-- Buscador -->
    <div class="col-span-3 md:col-span-1 flex justify-end">
      <SearchBox />
    </div>

    <!-- Controles derecha -->
    <div class="col-span-1 flex items-center justify-end gap-2">
      <ThemeToggle />
      <LangSwitcher />
      <GithubButton />
    </div>
  </div>
</header>
